# Server-side API key for AIHubMix.
# Keep this value only in local .env and never expose it on the client.
AIHUBMIX_API_KEY="YOUR_AIHUBMIX_API_KEY"

# Optional: force mock mode even if API key is present.
# true = always use mock responses
# false = use real AI when AIHUBMIX_API_KEY is provided
MOCK_AI=true

# Optional: API server port (defaults to 3001)
PORT=3001
